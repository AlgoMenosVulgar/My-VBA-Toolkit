Option Explicit

Private Const PASS_PRIORITY As String = "ES"

Public Sub UnprotectEverything()
    Dim app As Application, wb As Workbook, ws As Worksheet
    Dim fso As Object, folder As Object, file As Object
    Dim folderPath As String, t As Double
    
    Set app = Application
    ' Disable alerts and events to prevent popups and lag
    app.ScreenUpdating = False: app.DisplayAlerts = False: app.EnableEvents = False
    app.Calculation = xlCalculationManual: t = Timer
    
    folderPath = ThisWorkbook.Path & "\"
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set folder = fso.GetFolder(folderPath)

    ' 1. Process THIS workbook first
    UnlockWB ThisWorkbook

    ' 2. Process all other Excel files in the same folder
    For Each file In folder.Files
        If IsExcel(file.Name) And LCase(file.Path) <> LCase(ThisWorkbook.FullName) Then
            Dim targetWB As Workbook
            On Error Resume Next
            Set targetWB = app.Workbooks.Open(file.Path, 0, False)
            If Err.Number = 0 Then
                UnlockWB targetWB
                targetWB.Close True ' Save and Close
            End If
            On Error GoTo 0
        End If
    Next

    ' Reset Excel environment
    app.Calculation = xlCalculationAutomatic
    app.ScreenUpdating = True: app.DisplayAlerts = True: app.EnableEvents = True
    MsgBox "Process Finished." & vbCrLf & "Time: " & Format(Timer - t, "0.00") & "s", vbInformation
End Sub

' Logic to handle both Workbook structure and individual Sheets
Private Sub UnlockWB(wb As Workbook)
    Dim ws As Worksheet
    
    ' Check Workbook Protection
    If wb.ProtectStructure Or wb.ProtectWindows Then TryUnlock wb
    
    ' Check each Worksheet
    For Each ws In wb.Worksheets
        If ws.ProtectContents Then TryUnlock ws
    Next ws
End Sub

' The Core 2-Step Logic
Private Sub TryUnlock(obj As Object)
    On Error Resume Next
    
    ' Step 1: Try "ES"
    obj.Unprotect PASS_PRIORITY
    If Not IsLocked(obj) Then Exit Sub
    
    ' Step 2: If "ES" failed, ask the user
    ' We must briefly turn ScreenUpdating ON to see the InputBox clearly
    Application.ScreenUpdating = True
    
    Dim manualPass As String
    Dim targetName As String
    targetName = IIf(TypeName(obj) = "Workbook", "Workbook Structure", "Sheet: " & obj.Name)
    
    manualPass = InputBox("Password 'ES' failed for:" & vbCrLf & _
                          "File: " & obj.Parent.Name & vbCrLf & _
                          "Target: " & targetName & vbCrLf & vbCrLf & _
                          "Enter new password (or leave blank to skip):", "Manual Password Required")
    
    If manualPass <> "" Then
        obj.Unprotect manualPass
    End If
    
    Application.ScreenUpdating = False
End Sub

' Helper: Checks if the object is still locked
Private Function IsLocked(obj As Object) As Boolean
    If TypeName(obj) = "Workbook" Then
        IsLocked = (obj.ProtectStructure Or obj.ProtectWindows)
    Else
        IsLocked = obj.ProtectContents
    End If
End Function

' Helper: Identifies Excel files and ignores temp files
Private Function IsExcel(n As String) As Boolean
    IsExcel = (InStr(1, ".xls .xlsx .xlsm .xlsb", Right(LCase(n), 4)) > 0) And (Left(n, 2) <> "~$")
End Function
